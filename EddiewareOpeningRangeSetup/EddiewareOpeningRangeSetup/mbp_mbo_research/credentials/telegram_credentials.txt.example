# Credenciales del bot de Telegram para el puente Claude <-> mensajes.
#
# USA UN BOT APARTE del que ocupa ATAS. Telegram rechaza dos pollers
# simultaneos sobre el mismo token, asi que si 01_TelegramTradeNotifier.cs
# esta leyendo updates, el puente y ATAS se van a pelear y uno de los dos
# dejara de recibir mensajes.
#
# Como crear el segundo bot:
#   1. En Telegram habla con @BotFather
#   2. /newbot  -> le pones nombre, te da el token
#   3. Mandale un mensaje cualquiera al bot nuevo
#   4. Abre https://api.telegram.org/bot<TOKEN>/getUpdates y copia
#      el "chat":{"id":...} que aparece
#   5. Pega token y chat_id abajo
#
# Si este archivo no existe, el puente cae al de
# Desktop/Performance/telegram_process_files/telegram_credentials.txt
# (el bot de ATAS), con el riesgo de conflicto descrito arriba.
#
# Renombra este archivo a telegram_credentials.txt (sin .example).

token=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
chat_id=123456789
