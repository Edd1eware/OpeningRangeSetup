<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EddieWare.OpeningRangeSetup.Codex</AssemblyName>
    <RootNamespace>ATAS.Indicators.Codex</RootNamespace>
    <InstallToAtas Condition="'$(InstallToAtas)' == ''">false</InstallToAtas>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>C:\Program Files (x86)\ATAS Platform\ATAS.Indicators.dll</HintPath>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>C:\Program Files (x86)\ATAS Platform\ATAS.DataFeedsCore.dll</HintPath>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Rendering.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="InstallCodexIndicator" AfterTargets="Build" Condition="'$(InstallToAtas)' == 'true'">
    <PropertyGroup>
      <AtasIndicatorsDirectory>$(APPDATA)\ATAS\Indicators</AtasIndicatorsDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(AtasIndicatorsDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AtasIndicatorsDirectory)" SkipUnchangedFiles="true" />
  </Target>

</Project>
