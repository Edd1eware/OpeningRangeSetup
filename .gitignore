# Build output — rebuilt from source, and the DLL is deployed to ATAS from disk,
# never from the repository.
bin/
obj/
*.dll
*.pdb

# Visual Studio / Rider local state
.vs/
.idea/
*.suo
*.user
*.vsidx

# Python caches
__pycache__/
*.pyc

# Run artifacts: logs, pids and progress files are regenerated on every run
*.log
*.pid
run_logs/
catboost_info/

# Temp files from the atomic file bridges
*.tmp

# Node dependencies pulled in by the browser-driven labs
node_modules/

# Raw market data caches. GitHub rejects anything over 100 MB and these are
# rebuilt from the vendor feed or from the ATAS tick cache.
*.npz
*.dbn
*.dbn.zst
